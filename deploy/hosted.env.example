# Example: edit the hostname and install paths for the actual server.
ACCENT_COACH_MODE=hosted
ACCENT_COACH_HOST=127.0.0.1
PORT=7861
ACCENT_COACH_PUBLIC_URL=https://coach.example.com
ACCENT_COACH_ALLOWED_HOSTS=coach.example.com
ACCENT_COACH_DATA_DIR=/var/lib/accent-coach
FORWARDED_ALLOW_IPS=127.0.0.1
ACCENT_COACH_OPEN_BROWSER=0
ACCENT_COACH_GENERATION_BACKEND=kokoro
ACCENT_COACH_KOKORO_PYTHON=/opt/accent-coach/voice_generation/.venv/bin/python
